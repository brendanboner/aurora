# Aurora Project - Environment Configuration Template
# Copy this file to .env and fill in your actual values

# =============================================================================
# Docker Network Configuration
# =============================================================================
DOCKER_NETWORK=aurora-network

# =============================================================================
# RabbitMQ Configuration
# =============================================================================
RABBITMQ_HOST=aurora-rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=user
RABBITMQ_PASSWORD=your_rabbitmq_password_here
RABBITMQ_QUEUE=scraped_content
RABBITMQ_IMAGE=rabbitmq:4.2.0-management-alpine

# =============================================================================
# Neo4j Configuration
# =============================================================================
NEO4J_HOST=aurora-neo4j
NEO4J_URI=bolt://aurora-neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j
NEO4J_IMAGE=neo4j:2025-community

# =============================================================================
# Azure OpenAI Configuration
# =============================================================================
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=your_deployment_name_here
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1

# =============================================================================
# Digester /Content Processing Configuration
# =============================================================================
MAX_CHUNK_SIZE=8000
CHUNK_OVERLAP=500

# =============================================================================
# Retriever / Scraper Configuration
# =============================================================================
SCRAPER_DELAY=0.5
SCRAPER_MAX_REDIRECTS=10

# Output Mode: "rabbitmq" for production, "json" for generating test messages
OUTPUT_MODE=rabbitmq


# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=INFO

# =============================================================================
# Port Mappings
# =============================================================================
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
SCRAPER_API_PORT=8000

# Isolated environment ports (different from shared to allow both to run simultaneously)
ISOLATED_RABBITMQ_MANAGEMENT_PORT=15673
ISOLATED_NEO4J_HTTP_PORT=7475
ISOLATED_NEO4J_BOLT_PORT=7688

# Postgres microservice config
POSTGRES_DB=aurora
POSTGRES_USER=aurora
POSTGRES_PASSWORD=aurora_password
POSTGRES_HOST=aurora-postgres
POSTGRES_PORT=5432

# For Python services (backend, etc.)
PG_DSN=postgresql://aurora:aurora_password@aurora-postgres:5432/aurora
