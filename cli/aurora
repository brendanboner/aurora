#!/usr/bin/env bash
# Aurora CLI wrapper - uses uv to run with proper dependencies
# Captures original working directory so parse script can resolve relative paths.

ORIGINAL_CWD="$(pwd)"
export ORIGINAL_CWD

# Get the directory where this script is located
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

# Check if first argument is 'parse'
if [ "$1" = "parse" ]; then
        # Run aurora_parse.py with remaining arguments
        shift
        cd "$SCRIPT_DIR" && exec uv run python3 aurora_parse.py "$@"
else
        # Run aurora_query.py with all arguments
        cd "$SCRIPT_DIR" && exec uv run python3 aurora_query.py "$@"
fi
