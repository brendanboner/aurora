# Aurora CLI Environment Variables
# Copy this file to the workspace root as .env and update with your values

# User Authentication (for dev/testing, bypasses Cognito)
TEST_USER_ID=e4b864d8-5061-7019-73e7-c42cbfb4a2b7
TEST_USER_EMAIL=bbonner@extremenetworks.com
AURORA_ROLE=user

# Oracle Service URL (optional, defaults to http://localhost:8003)
AURORA_ORACLE_URL=http://localhost:8003

# Document Metadata Defaults (for parse command)
AURORA_ORG=
AURORA_EVENT=
AURORA_LOCATION=
AURORA_DATE=
AURORA_SOURCE=
AURORA_CATEGORY=other
