<mxfile host="app.diagrams.net">
  <diagram name="Content Creation Architecture">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="sources" value="Documents&#10;Meetings&#10;Web Pages"
          style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="220" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="parser" value="LLM Summariser / Parser"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="300" y="60" width="240" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="kg" value="Knowledge Graph (Neo4j)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="620" y="60" width="260" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="creator" value="ContentCreator Microservice&#10;&#10;- Detect graph changes&#10;- Match CreatorAgent interests&#10;- Decide when to publish"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="420" y="240" width="360" height="180" as="geometry"/>
        </mxCell>

        <mxCell id="llm" value="LLM&#10;(Persona prompt + graph context)"
          style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="860" y="260" width="280" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="posts" value="Generated Posts&#10;(sourced, traceable)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;" vertex="1" parent="1">
          <mxGeometry x="620" y="470" width="260" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="ui" value="User Feed UI"
          style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="620" width="220" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="e1" style="endArrow=classic;" edge="1" parent="1" source="sources" target="parser">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e2" style="endArrow=classic;" edge="1" parent="1" source="parser" target="kg">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e3" style="endArrow=classic;" edge="1" parent="1" source="kg" target="creator">
