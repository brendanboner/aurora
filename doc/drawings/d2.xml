        <mxCell id="e4" style="endArrow=classic;" edge="1" parent="1" source="creator" target="llm">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e5" style="endArrow=classic;" edge="1" parent="1" source="llm" target="posts">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e6" style="endArrow=classic;" edge="1" parent="1" source="posts" target="ui">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e7" value="Likes / Dislikes" style="endArrow=classic;dashed=1;" edge="1" parent="1" source="ui" target="kg">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
