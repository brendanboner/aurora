        },
        {
          "name": "Software-Defined Networking",
          "classification": "technology",
          "identifier": null,
          "issuer": null,
          "aliases": ["SDN"]
        }
      ],
      "expected_unique_count": 0,
      "expected_duplicates": 3
    },
    {
      "name": "Edge Cases - Punctuation and Spacing",
      "description": "Test handling of punctuation, spacing, and special characters",
      "topics": [
        {
          "name": "Wi-Fi",
