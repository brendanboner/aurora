# =============================================================================
# Aurora Environment Configuration - DEVELOPMENT
# =============================================================================
# This file contains environment variables for local development.
# Infrastructure services have exposed ports for debugging.
#
# Usage:
#   cp .env.dev .env
#   docker compose up --build -d
# =============================================================================

# =============================================================================
# AWS CONFIGURATION (For Docker image deployment)
# =============================================================================
# Your AWS ECR registry URL (format: <account-id>.dkr.ecr.<region>.amazonaws.com)
# Only needed if pushing images to ECR (e.g., make ship-all)
ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com
AWS_REGION=us-east-1
AWS_SSO_PROFILE=your_aws_sso_profile_name_here
EC2_INSTANCE_ID=i-xxxxxxxxxxxx

# -----------------------------------------------------------------------------
# S3 Document Storage (For document upload feature)
# -----------------------------------------------------------------------------
S3_DOCUMENT_BUCKET=aurora-document-uploads
MAX_UPLOAD_SIZE_MB=50


# =============================================================================
# SECTION 1: BACKUP CONFIGURATION
# =============================================================================

# Directory where backups are stored (default: ~/backups/aurora)
BACKUP_DIR=${HOME}/backups/aurora

# Days to retain backups before automatic cleanup (default: 7)
BACKUP_RETENTION_DAYS=7

# Backup Redis cache/sessions? (true/false, default: false)
BACKUP_REDIS=false

# =============================================================================
# SECTION 2: INFRASTRUCTURE SERVICES
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL (Backend User Database)
# -----------------------------------------------------------------------------
POSTGRES_DB=aurora
POSTGRES_USER=aurora
POSTGRES_PASSWORD=aurora_dev_password
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Neo4j (Knowledge Graph)
# -----------------------------------------------------------------------------
NEO4J_DATABASE=neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_dev_password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# -----------------------------------------------------------------------------
# RabbitMQ (Message Queue)
# -----------------------------------------------------------------------------
RABBITMQ_USER=aurora
RABBITMQ_PASSWORD=rabbitmq_dev_password
RABBITMQ_QUEUE=scraped_content
RABBITMQ_MAX_WORKERS=4
RABBITMQ_HEARTBEAT=180
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# -----------------------------------------------------------------------------
# Redis (Cache & Session Store)
# -----------------------------------------------------------------------------
REDIS_PORT=6379

# =============================================================================
# SECTION 3: AI/ML SERVICES
# =============================================================================

# -----------------------------------------------------------------------------
# Azure OpenAI (Required for LLM features)
# -----------------------------------------------------------------------------
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-4o
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1
LLM_RATE_LIMIT_RETRIES=3

# LLM Rate Limiting (Proactive - Digester only)
LLM_RATE_LIMIT_ENABLED=true
LLM_MAX_REQUESTS_PER_MINUTE=60
LLM_MAX_TOKENS_PER_MINUTE=10000

# YouTube Rate Limiting (Oracle service)
YOUTUBE_TRANSCRIPT_MAX_REQUESTS=60
YOUTUBE_TRANSCRIPT_TIME_WINDOW=3600
RABBITMQ_MAX_REQUESTS=20
RABBITMQ_TIME_WINDOW=10

# -----------------------------------------------------------------------------
# Embedding Configuration (for vector indexes)
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=text-embedding-3-small

# =============================================================================
# SECTION 4: APPLICATION SERVICES
# =============================================================================

# -----------------------------------------------------------------------------
# AWS Cognito (Authentication)
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_APP_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_DOMAIN=your-app-domain.auth.us-east-1.amazoncognito.com

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
APPLICATION_URL=http://localhost:3000
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# -----------------------------------------------------------------------------
# Application Service Ports
# -----------------------------------------------------------------------------
AUTH_PORT=8000
FRONTEND_PORT=3000

# -----------------------------------------------------------------------------
# Service URLs (Internal Docker Network)
# -----------------------------------------------------------------------------
BACKEND_SERVICE_URL=http://backend:8000
CURATOR_SERVICE_URL=http://curator:8000
RETRIEVER_SERVICE_URL=http://retriever:8000
CONTENT_CREATOR_SERVICE_URL=http://content_creator_service:8000
ORACLE_SERVICE_URL=http://oracle:8000

# -----------------------------------------------------------------------------
# Web Scraping Configuration
# -----------------------------------------------------------------------------
# WFA Causeway Authentication (for authenticated portal access)
WFA_CAUSEWAY_USERNAME=your_username
WFA_CAUSEWAY_PASSWORD=your_password

# WBA Authentication (for document downloads)
WBA_USERNAME=your_username
WBA_PASSWORD=your_password

# =============================================================================
# SECTION 5: PROCESSING CONFIGURATION
# =============================================================================

# -----------------------------------------------------------------------------
# Content Processing
# -----------------------------------------------------------------------------
MAX_CHUNK_SIZE=8000
CHUNK_OVERLAP=500
MAX_MESSAGE_RETRIES=3

# -----------------------------------------------------------------------------
# Curator Configuration
# -----------------------------------------------------------------------------
CLUSTER_MIN_SIZE=3
CLUSTER_MAX_SIZE=10
CLUSTER_DISTANCE_THRESHOLD=0.5
CLUSTER_OVERLAP_NEIGHBORS=3
MAX_TOPICS_PER_LLM_CALL=20
HIERARCHY_CONFIDENCE_THRESHOLD=0.7
ENABLE_CROSS_CLUSTER_ANALYSIS=true

TOPIC_ORGANIZATION_CRON=0 6 * * *
TOPIC_THRESHOLD_ENABLED=true
TOPIC_THRESHOLD_COUNT=50
TOPIC_THRESHOLD_CHECK_INTERVAL_SECONDS=60
EVENT_RECONCILIATION_CHECK_INTERVAL_SECONDS=60
EVENT_RECONCILIATION_ENABLED=true

# Curator Optimization (Algorithmic Inference)
USE_ALGORITHMIC_INFERENCE=true
ALGORITHMIC_CONFIDENCE_THRESHOLD=0.75
ENABLE_LLM_FALLBACK=true
LLM_REVIEW_INTERVAL_HOURS=24
INCREMENTAL_PROCESSING=true

# -----------------------------------------------------------------------------
# Application Environment Mode
# -----------------------------------------------------------------------------
# 'dev' = Scheduled scrapes disabled (manual triggers only)
# 'prod' = Scheduled scrapes enabled
APP_ENV=dev

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=DEBUG

# =============================================================================
# SECTION 6: DATA SOURCE CONFIGURATION
# =============================================================================

# -----------------------------------------------------------------------------
# Choose Your Data Source - Toggle by commenting/uncommenting
# -----------------------------------------------------------------------------

# USE PRODUCTION DATA via SSH TUNNEL
# Uncomment these lines to use production data via SSH tunnel:
# First run: ssh -i ~/.ssh/your_key.pem -L 7687:localhost:7687 -L 7474:localhost:7474 -L 5672:localhost:5672 -L 15672:localhost:15672 ec2-user@your_ec2_instance_ip
# NEO4J_URI=bolt://host.docker.internal:7687
# NEO4J_USER=readonly
# NEO4J_PASSWORD=urjlqdo1dl
# NEO4J_DATABASE=neo4j

# RABBITMQ_HOST=host.docker.internal
# RABBITMQ_PORT=5672
# RABBITMQ_USER=aurora
# RABBITMQ_PASSWORD=rabbitmq_dev_password

# -----------------------------------------------------------------------------
# Note: All services (backend, curator, digester, retriever, oracle, etc.)
#       use the same NEO4J_* variables for consistency
# -----------------------------------------------------------------------------
