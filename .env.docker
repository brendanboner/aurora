# =============================================================================
# Aurora Docker Compose Environment Configuration
# =============================================================================
# This file contains environment variables for the Docker Compose setup.
# Copy this to .env and update with your actual values.
#
# Usage:
#   cp .env.docker .env
#   # Edit .env with your values
#   docker-compose up -d
#
# =============================================================================

# =============================================================================
# Docker Network Configuration
# =============================================================================
DOCKER_NETWORK=aurora-network

# =============================================================================
# PostgreSQL Configuration (Backend User Database)
# =============================================================================
POSTGRES_DB=aurora
POSTGRES_USER=aurora
POSTGRES_PASSWORD=aurora_password_change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# PostgreSQL DSN (auto-constructed, but can override)
PG_DSN=postgresql://aurora:aurora_password_change_me@postgres:5432/aurora

# =============================================================================
# Neo4j Configuration (Knowledge Graph)
# =============================================================================
NEO4J_HOST=aurora-neo4j
NEO4J_URI=bolt://aurora-neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j
NEO4J_IMAGE=neo4j:2025-community

# Port mappings for host access
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# =============================================================================
# RabbitMQ Configuration (Message Queue)
# =============================================================================
RABBITMQ_HOST=aurora-rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=user
RABBITMQ_PASSWORD=password
RABBITMQ_QUEUE=scraped_content
RABBITMQ_IMAGE=rabbitmq:4.2.0-management-alpine

# RabbitMQ Threading (Digester)
RABBITMQ_MAX_WORKERS=4
RABBITMQ_HEARTBEAT=180

# Port mappings for host access
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# =============================================================================
# Azure OpenAI Configuration (Required for LLM features)
# =============================================================================
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=your_deployment_name_here
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1

# =============================================================================
# Content Processing Configuration (Digester)
# =============================================================================
MAX_CHUNK_SIZE=8000
CHUNK_OVERLAP=500

# =============================================================================
# Scraper Configuration (Retriever)
# =============================================================================
SCRAPER_DELAY=0.5
SCRAPER_MAX_REDIRECTS=10
SCRAPER_API_PORT=8001

# Output Mode: "rabbitmq" for production, "json" for generating test messages
OUTPUT_MODE=rabbitmq

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=INFO

# =============================================================================
# Port Mappings for Host Access
# =============================================================================
# Backend API
BACKEND_PORT=8000

# Frontend
FRONTEND_PORT=3000

# =============================================================================
# Isolated Environment Ports (for Makefile isolated deployments)
# =============================================================================
# These are different from shared to allow both to run simultaneously
ISOLATED_RABBITMQ_MANAGEMENT_PORT=15673
ISOLATED_NEO4J_HTTP_PORT=7475
ISOLATED_NEO4J_BOLT_PORT=7688

# =============================================================================
# Service URLs (for reference)
# =============================================================================
# Once running, access services at:
# - Frontend:              http://localhost:3000
# - Backend API:           http://localhost:8000
# - Backend Health:        http://localhost:8000/health
# - Backend API Docs:      http://localhost:8000/docs
# - RabbitMQ Management:   http://localhost:15672
# - Neo4j Browser:         http://localhost:7474
# - Retriever API:         http://localhost:8001
