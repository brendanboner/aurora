# Bot Configuration
BOT_ID=
BOT_PASSWORD=
BOT_PORT=3978

# Aurora Configuration
AURORA_API_URL=http://aurora-backend:8000
AURORA_ORACLE_URL=http://aurora-oracle:8000
AURORA_CONTENT_CREATOR_URL=http://aurora-content-creator:8000
AURORA_FRONTEND_URL=http://localhost:3000

# Service-to-service authentication token (for bot to access backend)
# This should match AURORA_SERVICE_TOKEN in the backend
AURORA_SERVICE_TOKEN=

# Enable mock mode for testing without backend authentication
# Set to 'true' to return sample data instead of calling Aurora APIs
USE_MOCK_DATA=false

# Test user email for emulator (optional - defaults to test@example.com)
TEST_USER_EMAIL=
# Test user ID (Cognito UUID) - required for backend authentication
TEST_USER_ID=
