{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "Container",
      "items": [
        {
          "type": "TextBlock",
          "text": "${title}",
          "weight": "Bolder",
          "size": "Large",
          "wrap": true
        },
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "auto",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${agent_name}",
                  "isSubtle": true,
                  "spacing": "None",
                  "size": "Small"
                }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${created_at}",
                  "isSubtle": true,
                  "spacing": "None",
                  "size": "Small"
                }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${importance_label}",
                  "isSubtle": true,
                  "spacing": "None",
                  "size": "Small"
                }
              ]
            }
          ],
          "spacing": "Small"
        },
        {
          "type": "TextBlock",
          "text": "${summary}",
          "wrap": true,
          "spacing": "Medium"
        },
        {
          "type": "FactSet",
          "facts": [
            {
              "title": "Relevance:",
              "value": "${normalized_score}%"
            },
            {
              "title": "Topics:",
              "value": "${tags}"
            }
          ],
          "spacing": "Medium"
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.OpenUrl",
      "title": "Read Full Post",
      "url": "${frontend_url}/feed?post=${id}"
    }
  ]
}
