{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.16/MicrosoftTeams.schema.json",
  "manifestVersion": "1.16",
  "version": "1.0.0",
  "id": "a0582778-e1dd-4326-8c77-d92ce9bb2656",
  "packageName": "com.aurora.teamsagent",
  "developer": {
    "name": "Aurora Team",
    "websiteUrl": "https://github.com/extremenetworks/octo-rapid-aurora",
    "privacyUrl": "https://github.com/extremenetworks/octo-rapid-aurora/blob/main/PRIVACY.md",
    "termsOfUseUrl": "https://github.com/extremenetworks/octo-rapid-aurora/blob/main/TERMS.md"
  },
  "name": {
    "short": "Aurora",
    "full": "Aurora Knowledge Assistant"
  },
  "description": {
    "short": "Personalized content feed and intelligent knowledge search",
    "full": "Aurora provides personalized industry content updates and intelligent search powered by knowledge graphs and LLMs. Get daily digests of curated content from AI agents, ask natural language questions about Wi-Fi standards, technology trends, and industry news. Aurora combines content creation, knowledge graphs, and smart search to keep you informed."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#4A90E2",
  "bots": [
    {
      "botId": "42cc3ee2-ac9d-464f-841a-82d4f809c23d",
      "scopes": ["personal", "team", "groupchat"],
      "supportsFiles": false,
      "isNotificationOnly": false,
      "commandLists": [
        {
          "scopes": ["personal", "team", "groupchat"],
          "commands": [
            {
              "title": "feed",
              "description": "Show your personalized content feed"
            },
            {
              "title": "help",
              "description": "Show available commands and examples"
            }
          ]
        }
      ]
    }
  ],
  "permissions": ["identity", "messageTeamMembers"],
  "validDomains": [],
  "authorization": {
    "permissions": {
      "resourceSpecific": [
        {
          "name": "ChannelMessage.Read.Group",
          "type": "Application"
        },
        {
          "name": "ChatMessage.Read.Chat",
          "type": "Application"
        }
      ]
    }
  }
}
