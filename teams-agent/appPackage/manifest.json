{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.16/MicrosoftTeams.schema.json",
  "manifestVersion": "1.16",
  "version": "1.0.1",
  "id": "a0582778-e1dd-4326-8c77-d92ce9bb2656",
  "packageName": "com.aurora.teamsagent",
  "developer": {
    "name": "Aurora Team",
    "websiteUrl": "https://aurora-octo.xcloudiq.com",
    "privacyUrl": "https://aurora-octo.xcloudiq.com",
    "termsOfUseUrl": "https://aurora-octo.xcloudiq.com"
  },
  "name": {
    "short": "Aurora",
    "full": "Aurora Knowledge Assistant"
  },
  "description": {
    "short": "Personalized content feed and intelligent knowledge search",
    "full": "Aurora provides personalized industry content updates and intelligent search powered by knowledge graphs and LLMs. Get daily digests of curated content from AI agents, ask natural language questions about Wi-Fi standards, technology trends, and industry news."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#4A90E2",
  "staticTabs": [
    {
      "entityId": "aurora-chat",
      "name": "Chat",
      "contentUrl": "https://aurora-octo.xcloudiq.com",
      "websiteUrl": "https://aurora-octo.xcloudiq.com",
      "scopes": ["personal"]
    }
  ],
  "bots": [
    {
      "botId": "553343dc-1031-4f78-8d8d-f1241a69e473",
      "scopes": ["personal", "team", "groupchat"],
      "supportsFiles": false,
      "isNotificationOnly": false,
      "commandLists": [
        {
          "scopes": ["personal", "team", "groupchat"],
          "commands": [
            {
              "title": "/news",
              "description": "Brief news update since your last check"
            },
            {
              "title": "/feed",
              "description": "Show your personalized content feed"
            },
            {
              "title": "/agents",
              "description": "List available AI agents"
            },
            {
              "title": "/myagents",
              "description": "List your personal agents"
            },
            {
              "title": "/enhance",
              "description": "Re-run the last answer with deeper source analysis"
            },
            {
              "title": "/about",
              "description": "About Aurora"
            },
            {
              "title": "/clear",
              "description": "Reset conversation context"
            },
            {
              "title": "/help",
              "description": "Show available commands and examples"
            }
          ]
        }
      ]
    }
  ],
  "permissions": ["identity", "messageTeamMembers"],
  "validDomains": ["aurora-octo.xcloudiq.com"],
  "authorization": {
    "permissions": {
      "resourceSpecific": [
        {
          "name": "ChannelMessage.Read.Group",
          "type": "Application"
        },
        {
          "name": "ChatMessage.Read.Chat",
          "type": "Application"
        }
      ]
    }
  }
}
