{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.16/MicrosoftTeams.schema.json",
  "manifestVersion": "1.16",
  "version": "1.0.0",
  "id": "5f9b6a4d-2e1c-4c9f-a5b3-1d7e9c2f8a4b",
  "packageName": "com.extremenetworks.aurora.teams",
  "developer": {
    "name": "Extreme Networks",
    "websiteUrl": "https://extremenetworks.com",
    "privacyUrl": "https://extremenetworks.com/privacy",
    "termsOfUseUrl": "https://extremenetworks.com/terms"
  },
  "name": {
    "short": "Aurora",
    "full": "Extreme Aurora - Knowledge Assistant"
  },
  "description": {
    "short": "AI-powered knowledge assistant",
    "full": "Extreme Aurora is an intelligent assistant that combines conversational chat with a real-time knowledge feed, powered by your organization's knowledge graph."
  },
  "icons": {
    "outline": "icon-outline.png",
    "color": "icon-color.png"
  },
  "accentColor": "#0078D4",
  "configurableTabs": [
    {
      "configurationUrl": "https://aurora.octorapidlabs.com/teams?config=true",
      "canUpdateConfiguration": true,
      "scopes": ["team", "groupchat"]
    }
  ],
  "staticTabs": [
    {
      "entityId": "aurora-personal",
      "name": "Aurora",
      "contentUrl": "https://aurora.octorapidlabs.com/teams",
      "websiteUrl": "https://aurora.octorapidlabs.com/teams",
      "scopes": ["personal"]
    }
  ],
  "validDomains": [
    "aurora.octorapidlabs.com"
  ],
  "webApplicationInfo": {
    "id": "5f9b6a4d-2e1c-4c9f-a5b3-1d7e9c2f8a4b",
    "resource": "https://aurora.octorapidlabs.com"
  },
  "permissions": [
    "identity",
    "messageTeamMembers"
  ],
  "showLoadingIndicator": true,
  "isFullScreen": false
}
